{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "sample",
      "run"
    ],
    "properties": {
      "sample": {
        "type": "string",
        "minLength": 1
      },
      "run": {
        "type": "string",
        "minLength": 1
      },
      "bam": {
        "type": "string",
        "minLength": 1
      },
      "pod5": {
        "type": "string",
        "minLength": 1
      }
    },
    "oneOf": [
      {
        "required": [
          "bam"
        ],
        "not": {
          "required": [
            "pod5"
          ]
        }
      },
      {
        "required": [
          "pod5"
        ],
        "not": {
          "required": [
            "bam"
          ]
        }
      }
    ]
  }
}
