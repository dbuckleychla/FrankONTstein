process {
    // Threaded alignment/callers: a 16-CPU resource tier, capped by user limits.
    withName: 'ALIGN|CLAIR3|CLAIRS_TO_CALL|SNIFFLES_CALL|SEVERUS_TUMOR_UNPHASED|STELLERATOR' {
        cpus = { Math.min(16, params.max_cpus as int) }
        memory = { [32.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    }
    withName: 'CLASSY_COMBINED|NASVAR' {
        cpus = { Math.min(8, params.max_cpus as int) }
    }
    withName: CLAIR3 {
        containerOptions = { params.clair3_gpu.toString().toBoolean() ? (workflow.profile.tokenize(',').contains('apptainer') ? '--nv' : (workflow.profile.tokenize(',').contains('docker') ? '--gpus all' : '')) : '' }
    }
    withName: CLASSY_COMBINED { container = params.images.classy }
    withName: BCFTOOLS_MPILEUP {
        container = params.images.bcftools
        ext.args = '-Ob --min-BQ 0'
    }
    withName: BCFTOOLS_CALL {
        container = params.images.bcftools
        ext.args = '-mv -Oz'
    }
    withName: CLAIRS_TO_CALL { container = params.images.clairsto }
    withName: SNIFFLES_CALL { container = params.images.sniffles }
    withName: SEVERUS_TUMOR_UNPHASED { container = params.images.severus }
    withName: STELLERATOR { container = params.images.stellerator }
    withName: QDNASEQ_CALL { container = params.images.qdnaseq }
    withName: HMMCOPY_WIG { container = params.images.ichorcna }
}
