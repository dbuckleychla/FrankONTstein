MIME-Version: 1.0
Content-Type: multipart/mixed; boundary="FRANKONTSTEIN"

--FRANKONTSTEIN
Content-Type: text/x-shellscript; charset="us-ascii"

#!/bin/bash
set -euo pipefail
systemctl stop ecs || true
dnf install -y unzip curl
install -d /opt/frankontstein-bootstrap
cd /opt/frankontstein-bootstrap
curl --fail --location --retry 5 "https://awscli.amazonaws.com/awscli-exe-linux-x86_64-${aws_cli_version}.zip" -o awscliv2.zip
unzip -q awscliv2.zip
./aws/install --install-dir /opt/aws-cli --bin-dir /opt/aws-cli-bin
/opt/aws-cli/v2/current/bin/aws --version
systemctl start ecs --no-block
--FRANKONTSTEIN--
