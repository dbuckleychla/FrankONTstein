{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrankONTstein parameters",
  "type": "object",
  "properties": {
    "primary": {
      "type": "boolean",
      "default": false
    },
    "secondary": {
      "type": "boolean",
      "default": false
    },
    "tertiary": {
      "type": "boolean",
      "default": false
    },
    "bam": {
      "type": "string",
      "minLength": 1
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "string",
      "minLength": 1
    },
    "demux_samplesheet": {
      "type": "string",
      "minLength": 1,
      "description": "Local path (relative to the launch directory or absolute) or S3 URI to a sequencer CSV requiring experiment_id, kit, barcode and alias; extra columns accepted. experiment_id matches the input run; alias names output samples."
    },
    "reference_bundle": {
      "type": "string",
      "minLength": 1
    },
    "targets_bed": {
      "type": "string",
      "minLength": 1
    },
    "enrichment_bed": {
      "type": "string",
      "minLength": 1
    },
    "image_manifest": {
      "type": "string",
      "minLength": 1,
      "description": "Digest-pinned OCI image manifest; summary (Quarto) is required in every tier."
    },
    "callers": {
      "type": "string",
      "minLength": 1,
      "description": "Explicit caller selection; consensus is automatic only when both deepsomatic and clairsto are selected. Summary HTML is generated in every tier."
    },
    "sequencing_kit": {
      "type": "string",
      "minLength": 1,
      "description": "ONT sequencing kit; required for default adapter trimming unless supplied by demux_samplesheet or disabled with --no-trim-adapter."
    },
    "outdir": {
      "type": "string",
      "minLength": 1
    },
    "genome": {
      "enum": [
        "hg38",
        "GRCh38",
        "hs1",
        "CHM13",
        "t2t"
      ]
    },
    "clair3_gpu": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "enum": [
            "auto"
          ]
        }
      ],
      "default": "auto",
      "description": "Automatically use the active profile GPU queue or local basecall_device. False forces CPU; true requires GPU configuration."
    },
    "fasta": {
      "type": "string"
    },
    "fai": {
      "type": "string"
    },
    "reference_id": {
      "type": "string"
    },
    "steps": {
      "type": "object",
      "description": "Per-analysis assets: nasvar, clairsto, stellerator, delly, subchrom, ichorcna, basecall",
      "properties": {
        "basecall": {
          "type": "object",
          "required": [
            "model",
            "modified_models"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "modified_models": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "clair3": {
          "type": "object",
          "required": [
            "model"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1,
              "description": "Local or S3 directory containing matching Clair3 move-aware pileup.pt and full_alignment.pt weights."
            }
          }
        }
      }
    },
    "basecall_model": {
      "type": "string",
      "enum": [
        "sup",
        "hac",
        "fast"
      ],
      "default": "sup",
      "description": "Bundled Clair3 model selection: sup uses SUP v5.0; hac and fast use HAC v5.0."
    },
    "disable_qc": {
      "type": "boolean",
      "default": false,
      "description": "Skip comprehensive QC; retain CpG bedMethyl, Classy and required validation."
    },
    "disable-qc": {
      "type": "boolean",
      "description": "CLI alias for disable_qc; takes precedence when supplied."
    },
    "basecall": {
      "type": "boolean",
      "default": false
    },
    "pod5": {
      "type": "string",
      "minLength": 1
    },
    "basecall_tasks": {
      "type": "integer",
      "minimum": 1,
      "default": 16
    },
    "basecall_max_forks": {
      "type": "integer",
      "minimum": 1
    },
    "basecall_device": {
      "type": "string",
      "pattern": "^(?:[0-9]+|GPU-[a-fA-F0-9-]+)$"
    },
    "basecall_cpus": {
      "type": "integer",
      "minimum": 1,
      "default": 4,
      "description": "CPUs per Dorado chunk, capped by max_cpus."
    },
    "basecall_memory": {
      "type": "string",
      "default": "16 GB",
      "description": "Host RAM per Dorado chunk; multiplied by attempt and capped by max_memory. Not GPU VRAM."
    },
    "clairsto_gpu": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "enum": [
            "auto"
          ]
        }
      ],
      "default": false,
      "description": "Defaults to CPU because the pinned image has a GPU indel model placement bug. Enable GPU only with a validated corrected image."
    },
    "clairsto_gpu_threads": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Concurrent ClairS-TO workers when using one GPU; start with one to limit VRAM use."
    },
    "deepsomatic_gpu": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "enum": [
            "auto"
          ]
        }
      ],
      "default": "auto",
      "description": "Use the active GPU queue/device for DeepSomatic; false forces CPU, true requires GPU configuration."
    },
    "deepsomatic_cpus": {
      "type": "integer",
      "minimum": 1,
      "default": 8,
      "description": "DeepSomatic CPUs and example-generation shards, capped by max_cpus."
    },
    "deepsomatic_memory": {
      "type": "string",
      "default": "64 GB",
      "description": "DeepSomatic host RAM; multiplied by attempt, capped by max_memory."
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "description": "Run label appended to AWS work/results prefixes; reuse with -resume."
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "description": "Direct multiplexed BAM/POD5 run identity; must match demux sheet experiment_id. Use sample_id for singleton inputs."
    },
    "max_retries": {
      "type": "integer",
      "minimum": 0,
      "default": 2,
      "description": "Maximum retries per failed process task, in addition to the initial attempt."
    },
    "no_trim_adapter": {
      "type": "boolean",
      "default": false,
      "description": "Disable default adapter/primer trimming. Demux barcode trimming remains enabled."
    }
  },
  "required": [
    "targets_bed",
    "enrichment_bed",
    "image_manifest"
  ],
  "allOf": [
    {
      "oneOf": [
        {
          "required": [
            "bam",
            "sample_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "pod5"
                ]
              },
              {
                "required": [
                  "input"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "pod5",
            "sample_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "bam"
                ]
              },
              {
                "required": [
                  "input"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "input"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "bam"
                ]
              },
              {
                "required": [
                  "pod5"
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "not": {
        "required": [
          "primary",
          "secondary"
        ],
        "properties": {
          "primary": {
            "const": true
          },
          "secondary": {
            "const": true
          }
        }
      }
    },
    {
      "not": {
        "required": [
          "primary",
          "tertiary"
        ],
        "properties": {
          "primary": {
            "const": true
          },
          "tertiary": {
            "const": true
          }
        }
      }
    },
    {
      "not": {
        "required": [
          "secondary",
          "tertiary"
        ],
        "properties": {
          "secondary": {
            "const": true
          },
          "tertiary": {
            "const": true
          }
        }
      }
    },
    {
      "oneOf": [
        {
          "required": [
            "reference_bundle"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "fasta"
                ]
              },
              {
                "required": [
                  "fai"
                ]
              }
            ]
          },
          "properties": {
            "steps": {
              "propertyNames": {
                "enum": [
                  "basecall"
                ]
              }
            }
          }
        },
        {
          "required": [
            "genome",
            "fasta"
          ],
          "not": {
            "required": [
              "reference_bundle"
            ]
          }
        }
      ]
    },
    {
      "if": {
        "not": {
          "required": [
            "no_trim_adapter"
          ],
          "properties": {
            "no_trim_adapter": {
              "const": true
            }
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "sequencing_kit"
            ],
            "properties": {
              "sequencing_kit": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              }
            }
          },
          {
            "required": [
              "demux_samplesheet"
            ],
            "properties": {
              "demux_samplesheet": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "required": [
          "basecall"
        ],
        "properties": {
          "basecall": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "steps"
        ],
        "properties": {
          "steps": {
            "required": [
              "basecall"
            ]
          }
        },
        "not": {
          "required": [
            "bam"
          ]
        }
      },
      "else": {
        "not": {
          "required": [
            "pod5"
          ]
        }
      }
    },
    {
      "not": {
        "required": [
          "trim"
        ]
      }
    }
  ]
}
