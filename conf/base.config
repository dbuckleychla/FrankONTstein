process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    cpus = { Math.min(1, params.max_cpus as int) }
    memory = { [2.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    time = { [4.h * task.attempt, params.max_time as nextflow.util.Duration].min() }
    errorStrategy = 'retry'
    maxRetries = params.max_retries
    withLabel: high_memory {
        cpus = { Math.min(16, params.max_cpus as int) }
        memory = { [32.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    }
}
