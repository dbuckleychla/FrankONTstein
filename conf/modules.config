process {
    withName: 'SOMATIC_CONSENSUS|SAMPLE_SUMMARY' {
        cpus = { Math.min(2, params.max_cpus as int) }
        memory = { [4.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    }
    withName: DORADO_BASECALL {
        cpus = { Math.min(params.basecall_cpus as int, params.max_cpus as int) }
        memory = { [(params.basecall_memory as nextflow.util.MemoryUnit) * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
        containerOptions = { workflow.profile.tokenize(',').contains('apptainer') ? '--nv' : (workflow.profile.tokenize(',').contains('aws') ? '' : "--gpus device=${params.basecall_device}") }
    }
    withName: 'ALIGN' {
        cpus = { Math.min(32, params.max_cpus as int) }
        memory = { [64.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    }
    withName: 'CLAIR3|CLAIRS_TO_CALL' {
        cpus = { Math.min(16, params.max_cpus as int) }
        memory = { [32.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    }
    withName: 'SNIFFLES_CALL' {
        cpus = { Math.min(8, params.max_cpus as int) }
        memory = { [8.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    }
    withName: 'SEVERUS_TUMOR_UNPHASED' {
        cpus = { Math.min(4, params.max_cpus as int) }
        memory = { [16.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    }
    withName: 'STELLERATOR' {
        cpus = { Math.min(4, params.max_cpus as int) }
        memory = { [12.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    }
    withName: 'CLASSY_COMBINED|MODKIT_PILEUP' {
        cpus = { Math.min(8, params.max_cpus as int) }
        memory = { [16.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    }
    withName: 'SAMPLE_QC' {
        cpus = { Math.min(16, params.max_cpus as int) }
        memory = { [4.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    }
    withName: 'NASVAR' {
        cpus = { Math.min(2, params.max_cpus as int) }
        memory = { [8.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    }
    withName: 'PREPARE_BAM|TRIM_BAM' {
        cpus = { Math.min(4, params.max_cpus as int) }
        memory = { [8.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    }
    withName: 'DEMULTIPLEX' {
        cpus = { Math.min(8, params.max_cpus as int) }
        memory = { [8.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    }
    withName: 'OFF_TARGET_BAM' {
        cpus = { Math.min(16, params.max_cpus as int) }
        memory = { [16.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    }
    withName: 'BCFTOOLS_MPILEUP' {
        cpus = { Math.min(4, params.max_cpus as int) }
        memory = { [4.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    }
    withName: 'SUBCHROM' {
        cpus = { Math.min(2, params.max_cpus as int) }
        memory = { [8.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    }
    withName: 'DELLY|QDNASEQ_CALL' {
        cpus = { Math.min(2, params.max_cpus as int) }
        memory = { [4.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    }
    withName: 'DEMUX_QC' {
        cpus = { Math.min(2, params.max_cpus as int) }
        memory = { [2.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
    }
    withName: CLAIR3 {
        containerOptions = { (params.clair3_gpu.toString() == 'auto' ? (workflow.profile.tokenize(',').contains('aws') ? !!params.aws_gpu_queue : workflow.profile.tokenize(',').contains('slurm') ? !!params.gpu_queue : params.basecall_device != null) : params.clair3_gpu.toString().toBoolean()) ? (workflow.profile.tokenize(',').contains('apptainer') ? '--nv' : (workflow.profile.tokenize(',').contains('docker') ? "--gpus device=${params.basecall_device}" : '')) : '' }
    }
    withName: DEEPSOMATIC {
        cpus = { Math.min(params.deepsomatic_cpus as int, params.max_cpus as int) }
        memory = { [(params.deepsomatic_memory as nextflow.util.MemoryUnit) * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
        containerOptions = { (params.deepsomatic_gpu.toString() == 'auto' ? (workflow.profile.tokenize(',').contains('aws') ? !!params.aws_gpu_queue : workflow.profile.tokenize(',').contains('slurm') ? !!params.gpu_queue : params.basecall_device != null) : params.deepsomatic_gpu.toString().toBoolean()) ? (workflow.profile.tokenize(',').contains('apptainer') ? '--nv' : (workflow.profile.tokenize(',').contains('docker') ? "--gpus device=${params.basecall_device}" : '')) : '' }
    }
    withName: CLASSY_COMBINED { container = params.images.classy }
    withName: BCFTOOLS_MPILEUP {
        container = params.images.bcftools
    }
    withName: BCFTOOLS_CALL {
        container = params.images.bcftools
        ext.args = '-mv -Oz'
    }
    withName: CLAIRS_TO_CALL {
        cpus = { Math.min((params.clairsto_gpu.toString() == 'auto' ? (workflow.profile.tokenize(',').contains('aws') ? !!params.aws_gpu_queue : workflow.profile.tokenize(',').contains('slurm') ? !!params.gpu_queue : params.basecall_device != null) : params.clairsto_gpu.toString().toBoolean()) ? (params.clairsto_gpu_threads as int) : 16, params.max_cpus as int) }
        containerOptions = { (params.clairsto_gpu.toString() == 'auto' ? (workflow.profile.tokenize(',').contains('aws') ? !!params.aws_gpu_queue : workflow.profile.tokenize(',').contains('slurm') ? !!params.gpu_queue : params.basecall_device != null) : params.clairsto_gpu.toString().toBoolean()) ? (workflow.profile.tokenize(',').contains('apptainer') ? '--nv' : (workflow.profile.tokenize(',').contains('docker') ? "--gpus device=${params.basecall_device}" : '')) : '' }
    }
    withName: SNIFFLES_CALL {
        container = params.images.sniffles
        ext.args = { "--sample-id '${meta.id}'" }
    }
    withName: SEVERUS_TUMOR_UNPHASED { container = params.images.severus }
    withName: STELLERATOR { container = params.images.stellerator }
    withName: QDNASEQ_CALL { container = params.images.qdnaseq }
    withName: HMMCOPY_WIG { container = params.images.ichorcna }
}
