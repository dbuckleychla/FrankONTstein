manifest {
    name = 'FrankONTstein'
    author = 'FrankONTstein contributors'
    version = '0.1.0-dev'
    nextflowVersion = '!>=25.10.2'
    mainScript = 'main.nf'
}
params {
    basecall = false
    pod5 = null
    basecall_cpus = 4
    basecall_memory = '16 GB'
    basecall_tasks = 16
    basecall_max_forks = null
    basecall_device = null
    disable_qc = false
    basecall_model = 'sup'
    deepsomatic_gpu = 'auto'
    deepsomatic_cpus = 8
    deepsomatic_memory = '64 GB'
    clair3_gpu = 'auto'
    // TODO: restore GPU auto-routing after pinning and validating a patched ClairS-TO image.
    clairsto_gpu = false
    clairsto_gpu_threads = 1
    gpu_queue = null
    aws_gpu_queue = null
    primary = false
    secondary = false
    tertiary = false
    bam = null
    sample_id = null
    experiment_id = null
    input = null
    demux_samplesheet = null
    no_trim_adapter = false
    genome = null
    reference_bundle = null
    reference_id = null
    fasta = null
    fai = null
    steps = [:]
    enrichment_bed = null
    targets_bed = null
    callers = null
    run_id = null
    outdir = 'results'
    slurm_queue = null
    slurm_account = null
    aws_region = null
    aws_queue = null
    aws_job_role = null
    aws_cli_path = '/opt/aws-cli/v2/current/bin/aws'
    aws_logs_group = null
    max_retries = 2
    max_cpus = 32
    max_memory = '64 GB'
    max_time = '48 h'
    image_manifest = null
    sequencing_kit = null
    classy_container = null
    realtime = null
    cfdna = false
    qdnaseq_binsize = 100
    delly_bin_size = 100000
    ichor_bin_size = 1000000
    chr_wig = null
    help = false
}
params.images = params.image_manifest
    ? new groovy.json.JsonSlurper().parse(
        new File(params.image_manifest.toString()).isAbsolute()
            ? new File(params.image_manifest.toString())
            : new File(projectDir.toString(), params.image_manifest.toString()))
    : [preprocess:'UNSET', classy:'UNSET', nasvar:'UNSET']
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'
profiles {
    local {
        process.executor = 'local'
        params.max_cpus = Math.min(32, Runtime.runtime.availableProcessors())
    }
    docker {
        docker.enabled = true
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
    slurm { includeConfig 'conf/profiles/slurm.config' }
    aws { includeConfig 'conf/profiles/aws.config' }
}
trace { overwrite = true; fields = 'task_id,hash,name,status,exit,container,cpus,memory,queue,accelerator,submit,start,complete,duration,realtime,%cpu,peak_rss,read_bytes,write_bytes,attempt'; enabled = true; file = "${params.outdir}/pipeline_info/trace.tsv" }
report { overwrite = true; enabled = true; file = "${params.outdir}/pipeline_info/execution.html" }
timeline { overwrite = true; enabled = true; file = "${params.outdir}/pipeline_info/timeline.html" }
dag { overwrite = true; enabled = true; file = "${params.outdir}/pipeline_info/dag.html" }
