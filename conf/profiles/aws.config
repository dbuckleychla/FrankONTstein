// Optional defaults loaded by bin/aws_batch_env.py. CLI/params-file values retain priority.
params {
    aws_region = System.getenv('FRANKONTSTEIN_AWS_REGION') ?: params.aws_region
    aws_queue = System.getenv('FRANKONTSTEIN_AWS_QUEUE') ?: params.aws_queue
    aws_gpu_queue = System.getenv('FRANKONTSTEIN_AWS_GPU_QUEUE') ?: params.aws_gpu_queue
    aws_job_role = System.getenv('FRANKONTSTEIN_AWS_JOB_ROLE') ?: params.aws_job_role
    aws_logs_group = System.getenv('FRANKONTSTEIN_AWS_LOGS_GROUP') ?: params.aws_logs_group
    aws_cli_path = System.getenv('FRANKONTSTEIN_AWS_CLI_PATH') ?: params.aws_cli_path
    outdir = System.getenv('FRANKONTSTEIN_OUTDIR') ?: params.outdir
}
workDir = System.getenv('FRANKONTSTEIN_WORK_DIR') ?: 'work'

plugins { id 'nf-amazon@3.4.2' }
process {
    withName: DORADO_BASECALL {
        queue = params.aws_gpu_queue
        accelerator = 1
    }
    withName: CLAIR3 {
        accelerator = { params.clair3_gpu.toString().toBoolean() ? 1 : null }
        queue = { params.clair3_gpu.toString().toBoolean() ? params.aws_gpu_queue : params.aws_queue }
    }
    executor = 'awsbatch'
    queue = params.aws_queue
}
aws {
    region = params.aws_region
    batch.jobRole = params.aws_job_role
    batch.cliPath = params.aws_cli_path
    batch.logsGroup = params.aws_logs_group
}
docker.enabled = true
