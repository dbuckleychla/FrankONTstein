{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrankONTstein parameters",
  "type": "object",
  "properties": {
    "primary": {
      "type": "boolean",
      "default": false
    },
    "secondary": {
      "type": "boolean",
      "default": false
    },
    "tertiary": {
      "type": "boolean",
      "default": false
    },
    "trim": {
      "type": "boolean",
      "default": false
    },
    "bam": {
      "type": "string",
      "minLength": 1
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "string",
      "minLength": 1
    },
    "demux_samplesheet": {
      "type": "string",
      "minLength": 1
    },
    "reference_bundle": {
      "type": "string",
      "minLength": 1
    },
    "targets_bed": {
      "type": "string",
      "minLength": 1
    },
    "enrichment_bed": {
      "type": "string",
      "minLength": 1
    },
    "image_manifest": {
      "type": "string",
      "minLength": 1
    },
    "callers": {
      "type": "string",
      "minLength": 1
    },
    "sequencing_kit": {
      "type": "string",
      "minLength": 1,
      "description": "ONT sequencing kit; required with trim unless supplied by demux_samplesheet."
    },
    "outdir": {
      "type": "string",
      "minLength": 1
    },
    "genome": {
      "enum": [
        "hg38",
        "GRCh38",
        "hs1",
        "CHM13",
        "t2t"
      ]
    },
    "clair3_gpu": {
      "type": "boolean",
      "default": false
    },
    "fasta": {
      "type": "string"
    },
    "fai": {
      "type": "string"
    },
    "reference_id": {
      "type": "string"
    },
    "steps": {
      "type": "object",
      "description": "Per-analysis assets: nasvar, clairsto, stellerator, delly, subchrom, ichorcna"
    },
    "basecall_model": {
      "type": "string",
      "enum": [
        "sup",
        "hac",
        "fast"
      ],
      "default": "sup",
      "description": "Bundled Clair3 model selection: sup uses SUP v5.0; hac and fast use HAC v5.0."
    },
    "disable_qc": {
      "type": "boolean",
      "default": false,
      "description": "Skip comprehensive QC; retain CpG bedMethyl, Classy and required validation."
    },
    "disable-qc": {
      "type": "boolean",
      "description": "CLI alias for disable_qc; takes precedence when supplied."
    }
  },
  "required": [
    "targets_bed",
    "enrichment_bed",
    "image_manifest"
  ],
  "allOf": [
    {
      "oneOf": [
        {
          "required": [
            "bam",
            "sample_id"
          ],
          "not": {
            "required": [
              "input"
            ]
          }
        },
        {
          "required": [
            "input"
          ],
          "not": {
            "required": [
              "bam"
            ]
          }
        }
      ]
    },
    {
      "not": {
        "required": [
          "primary",
          "secondary"
        ],
        "properties": {
          "primary": {
            "const": true
          },
          "secondary": {
            "const": true
          }
        }
      }
    },
    {
      "not": {
        "required": [
          "primary",
          "tertiary"
        ],
        "properties": {
          "primary": {
            "const": true
          },
          "tertiary": {
            "const": true
          }
        }
      }
    },
    {
      "not": {
        "required": [
          "secondary",
          "tertiary"
        ],
        "properties": {
          "secondary": {
            "const": true
          },
          "tertiary": {
            "const": true
          }
        }
      }
    },
    {
      "oneOf": [
        {
          "required": [
            "reference_bundle"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "fasta"
                ]
              },
              {
                "required": [
                  "fai"
                ]
              },
              {
                "required": [
                  "steps"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "genome",
            "fasta"
          ],
          "not": {
            "required": [
              "reference_bundle"
            ]
          }
        }
      ]
    },
    {
      "if": {
        "required": [
          "trim"
        ],
        "properties": {
          "trim": {
            "const": true
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "sequencing_kit"
            ],
            "properties": {
              "sequencing_kit": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              }
            }
          },
          {
            "required": [
              "demux_samplesheet"
            ],
            "properties": {
              "demux_samplesheet": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    }
  ]
}
