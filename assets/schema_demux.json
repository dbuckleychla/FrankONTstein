{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "experiment_id",
      "kit",
      "barcode",
      "alias"
    ],
    "properties": {
      "experiment_id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      },
      "kit": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      },
      "barcode": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      },
      "alias": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      }
    },
    "additionalProperties": true
  },
  "description": "Sequencer demultiplexing sheet: experiment_id identifies the input run; alias names output samples. Other columns are optional and ignored for routing."
}
